(rule
 (targets camlinternalMenhirLib.ml)
 (action
  (with-stdout-to %{targets}
   ;; Partial applications of the form Obj.magic f x in menhirLib cause
   ;; an issue with locals, so rewrite these to Obj.magic (f x).
   ;; The engine builds its empty stack as a cyclic record with [let rec],
   ;; which the compiler does not accept; make the [next] field mutable and
   ;; tie the knot by assignment instead (see also the .mli rule below).
   (bash "cat $(menhir --suggest-menhirLib)/menhirLib.ml |
          sed 's/\\b\\(in\\|then\\|with\\|else\\)\\b/@@@\\1/g; s/Obj.magic \\([a-z0-9_]\\+\\( [a-z0-9_]\\+\\)\\+\\)/Obj.magic (\\1)/g;  s/@@@//g; s/^\\(  \\)\\(next: (.state, .semantic_value) stack;\\)/\\1mutable \\2/; s/let rec empty = {/let empty = {/; s/next = empty;/next = Obj.magic ();/; s/(\\* Build an initial environment. \\*)/empty.next <- empty;/'"))))

(rule
 (targets camlinternalMenhirLib.mli)
 (action
  (with-stdout-to %{targets}
   (bash "cat $(menhir --suggest-menhirLib)/menhirLib.mli |
          sed 's/^\\(  \\)\\(next: (.state, .semantic_value) stack;\\)/\\1mutable \\2/'"))))

(ocamllex
 (modules lexer)
 (mode fallback))
